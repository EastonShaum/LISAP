# Server
PORT=3000

# Gmail (the shared LISAP inbox). Locally, credentials.json + token.json work instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Full Pub/Sub topic name Gmail publishes to
GMAIL_WATCH_TOPIC=projects/your-gcp-project/topics/lisap

# Firebase Admin. Locally, serviceAccountKey.json works instead.
# Easiest on a host: the whole service account JSON, base64-encoded.
FIREBASE_SERVICE_ACCOUNT=
