{
  "name": "lisap",
  "version": "1.0.0",
  "description": "Push streaming sign-in codes to everyone who shares the account",
  "main": "worker/src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix client",
    "client": "npm start --prefix client",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute lisap --remote --file worker/schema.sql",
    "gettoken": "node getToken.js",
    "export-firestore": "node scripts/export-firestore.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
